* {
  box-sizing: border-box;
}

body {
  min-height: 100vh;
  margin: 0;
  display: grid;
  place-items: center;
  background: #f6f8fa;
  color: #24292f;
  font-family: Arial, sans-serif;
}

.card {
  width: min(100% - 32px, 440px);
  padding: 28px;
  background: #fff;
  border: 1px solid #d0d7de;
  border-radius: 12px;
  box-shadow: 0 4px 16px rgb(31 35 40 / 8%);
}

h1 {
  margin: 0 0 8px;
  font-size: 24px;
}

p {
  margin: 0 0 24px;
  color: #57606a;
}

label {
  display: block;
  margin: 16px 0 8px;
  font-weight: 600;
}

input,
select {
  width: 100%;
  padding: 10px 12px;
  border: 1px solid #d0d7de;
  border-radius: 6px;
  font: inherit;
}

button {
  width: 100%;
  margin-top: 24px;
  padding: 11px 16px;
  border: 0;
  border-radius: 6px;
  background: #1f883d;
  color: #fff;
  font: inherit;
  font-weight: 600;
  cursor: pointer;
}

button:hover {
  background: #1a7f37;
}
